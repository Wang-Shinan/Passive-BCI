{
  "name": "passive-bci",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "neuracle-bridge": "bash -c 'ROOT=\"${OI_MI_ROOT:-$HOME/Documents/oi-mi}\"; PY=\"$ROOT/.venv/bin/python\"; if [ ! -x \"$PY\" ]; then PY=python3; fi; OI_MI_ROOT=\"$ROOT\" \"$PY\" bridges/neuracle/ws_bridge.py'",
    "bcigo-bridge": "python bridges/bcigo/ws_bridge.py",
    "model-service": "node scripts/run-model-service.mjs",
    "model-service:reve": "node scripts/run-model-service.mjs --backend reve",
    "model-service:reve:tetris": "node scripts/run-model-service.mjs --backend reve --task tetris_action",
    "model-service:reve:smr": "node scripts/run-model-service.mjs --backend reve --task smr_control",
    "model-service:reve:smr:fit": "node scripts/fit-smr-head.mjs",
    "model-service:reve:smr:export": "node scripts/export-smr-hdf5.mjs",
    "model-service:mock": "node scripts/run-model-service.mjs --backend mock",
    "tetris-rl:parity": "bash -c 'cd tetris-rl && PYTHONPATH=. .venv/bin/python scripts/verify_parity.py'",
    "tetris-rl:train": "bash -c 'cd tetris-rl && PYTHONPATH=. .venv/bin/python scripts/train.py \"$@\"' --",
    "tetris-rl:train:smoke": "bash -c 'cd tetris-rl && PYTHONPATH=. .venv/bin/python scripts/train.py --smoke'",
    "tetris-rl:eval": "bash -c 'cd tetris-rl && PYTHONPATH=. .venv/bin/python scripts/evaluate.py \"$@\"' --",
    "tetris-rl:export": "bash -c 'cd tetris-rl && PYTHONPATH=. .venv/bin/python scripts/export_onnx.py \"$@\"' --"
  },
  "dependencies": {
    "onnxruntime-web": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
